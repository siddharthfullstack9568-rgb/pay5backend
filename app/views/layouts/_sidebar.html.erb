<aside class="w-[294px] bg-black text-white flex flex-col"
       data-controller="superadmindropdown">

  <!-- Logo -->
  <div class="p-6 flex justify-center">
    <div class="bg-white rounded-full px-10 py-3">
      <span class="text-black font-semibold tracking-widest">
        CREDICLE
      </span>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-4 space-y-3 overflow-y-auto">

    <!-- Home (Active) -->
    <a href="<%= root_path %>"
       class="flex items-center gap-3 px-5 py-3 rounded-full bg-white text-black font-medium">
      <i class="fa fa-home"></i>
      Dashboard
    </a>

    <!-- Super Admin -->
    <div>
      <button
        class="w-full flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition"
        data-action="click->superadmindropdown#toggle"
        data-menu="menu">
        <i class="fa fa-user-shield"></i>
        Super Admin
        <i class="fa fa-chevron-down ml-auto text-sm"></i>
      </button>

      <div data-superadmindropdown-target="menu"
           class="hidden mt-2 ml-8 space-y-2 text-sm">
        <a href="/superadmin/scheme/index" class="block hover:text-yellow-400">
          Scheme
        </a>
        <a href="/superadmin/banks" class="block hover:text-yellow-400">
          Bank Details
        </a>
      </div>
    </div>

    <!-- Admin -->
    <div>
      <button
        class="w-full flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition"
        data-action="click->superadmindropdown#toggle"
        data-menu="bankmenu">
        <i class="fa fa-user"></i>
        Admin
        <i class="fa fa-chevron-down ml-auto text-sm"></i>
      </button>

      <div data-superadmindropdown-target="bankmenu"
           class="hidden mt-2 ml-8 space-y-2 text-sm">
        <a href="/superadmin/admins/new" class="block hover:text-yellow-400">Create</a>
        <a href="/superadmin/admins" class="block hover:text-yellow-400">List</a>
        <a href="/superadmin/banks" class="block hover:text-yellow-400">Balance</a>
      </div>
    </div>

    <!-- Master / Dealer / Retailer -->
    <a href="/superadmin/retailers"
       class="flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition">
      <i class="fa fa-users"></i>
      Master Dealer / Retailer
    </a>

   <%#  <a href="/superadmin/retailers"
       class="flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition">
      <i class="fa fa-user"></i>
      Dealer / Retailer
    </a> %>

    <a href="/superadmin/services"
       class="flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition">
      <i class="fa fa-users"></i>
       Services
    </a>

    <!-- Fund Request -->
    <div>
      <button
        class="w-full flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition"
        data-action="click->superadmindropdown#toggle"
        data-menu="payment">
        <i class="fa fa-credit-card"></i>
        Fund Request
        <i class="fa fa-chevron-down ml-auto text-sm"></i>
      </button>

      <div data-superadmindropdown-target="payment"
           class="hidden mt-2 ml-8 space-y-2 text-sm">
        <a href="/superadmin/payments/index" class="block hover:text-yellow-400">
          List
        </a>
      </div>
    </div>

    <a href="/superadmin/commissions/service_list"
       class="flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition">
      <i class="fa fa-percent"></i>
      Set Commission
    </a>

    <!-- Account -->
    <div>
      <button
        class="w-full flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition"
        data-action="click->superadmindropdown#toggle"
        data-menu="account">
        <i class="fa fa-wallet"></i>
        Account
        <i class="fa fa-chevron-down ml-auto text-sm"></i>
      </button>

      <div data-superadmindropdown-target="account"
           class="hidden mt-2 ml-8 space-y-2 text-sm">
        <a href="/superadmin/accounts/index" class="block hover:text-yellow-400">
          Credit Note
        </a>
        <a href="/superadmin/accounts/debit_index" class="block hover:text-yellow-400">
          Debit Note
        </a>
      </div>
    </div>

    <!-- Report -->
    <a href="/superadmin/reports/index"
       class="flex items-center gap-3 px-5 py-3 rounded-full bg-gray-700 hover:bg-gray-600 transition">
      <i class="fa fa-file-alt"></i>
      Report
    </a>

  </nav>
</aside>
