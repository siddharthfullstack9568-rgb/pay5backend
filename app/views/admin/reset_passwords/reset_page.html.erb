<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-gray-50">

  <div class="bg-white rounded-2xl shadow-lg w-full max-w-lg p-8 m-auto" data-controller="password flash">
    <h2 class="text-3xl font-semibold text-center text-gray-800 mb-6">
      🔒 Reset Password
    </h2>

        <!-- ✅ Flash Message -->
    <% if flash[:notice].present? %>
      <div data-flash-target="message"
           class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-2 rounded-lg text-center">
        <%= flash[:notice] %>
      </div>
    <% elsif flash[:alert].present? %>
      <div data-flash-target="message"
           class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded-lg text-center">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <p class="text-sm text-gray-600 text-center mb-4">
      Enter your old and new password to reset your account.
    </p>

    <%= form_with url: admin_reset_passwords_reset_password_path,
                  method: :post,
                  local: true,
                  data: { action: "submit->password#checkOldPassword" },
                  id: "resetForm",
                  class: "space-y-4" do |f| %>

      <!-- Old Password -->
      <label class="text-sm font-medium text-gray-700">
        Old Password <span class="text-red-600">*</span>
      </label>
      <div class="relative">
        <%= f.password_field :old_password,
              data: { password_target: "oldPassword" },
              id: "old_password",
              placeholder: "Enter Old Password",
              required: true,
              class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none"
        %>
        <button type="button"
                data-action="click->password#toggle"
                data-target-id="oldPassword"
                class="absolute right-3 top-3 text-gray-600">
          <i data-lucide="eye"></i>
        </button>
      </div>

      <!-- New Password -->
      <label class="text-sm font-medium text-gray-700">
        New Password <span class="text-red-600">*</span>
      </label>
      <div class="relative">
        <%= f.password_field :password,
              data: { password_target: "password", action: "input->password#validate" },
              id: "password",
              placeholder: "Enter New Password",
              required: true,
              class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none"
        %>
        <button type="button"
                data-action="click->password#toggle"
                data-target-id="password"
                class="absolute right-3 top-3 text-gray-600">
          <i data-lucide="eye"></i>
        </button>
      </div>

      <!-- Confirm Password -->
      <label class="text-sm font-medium text-gray-700">
        Confirm Password <span class="text-red-600">*</span>
      </label>
      <div class="relative">
        <%= f.password_field :password_confirmation,
              data: { password_target: "confirmPassword", action: "input->password#validate" },
              id: "confirm_password",
              placeholder: "Confirm New Password",
              required: true,
              class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none"
        %>
        <button type="button"
                data-action="click->password#toggle"
                data-target-id="confirmPassword"
                class="absolute right-3 top-3 text-gray-600">
          <i data-lucide="eye"></i>
        </button>
      </div>

      <!-- Password Rules -->
      <div class="text-xs space-y-1 mt-2">
        <p data-password-target="ruleLength" class="text-red-600">• Minimum 8 characters</p>
        <p data-password-target="ruleUppercase" class="text-red-600">• One uppercase (A-Z)</p>
        <p data-password-target="ruleLowercase" class="text-red-600">• One lowercase (a-z)</p>
        <p data-password-target="ruleNumber" class="text-red-600">• One number (0-9)</p>
        <p data-password-target="ruleSpecial" class="text-red-600">• One special character (@$!%*?&#)</p>
        <p data-password-target="ruleMatch" class="text-red-600">• Passwords must match</p>
      </div>

      <%= f.submit "Reset Password",
            data: { password_target: "submitButton" },
            id: "submitBtn",
            disabled: true,
            class: "w-full text-white py-2 rounded-lg transition font-medium bg-gray-400 cursor-not-allowed"
      %>

      <p class="text-center text-sm text-gray-500 mt-2">
        Forgot old password?
        <%= link_to "Click here", forgot_sessions_path, class: "text-blue-600 hover:underline" %>
      </p>
    <% end %>
  </div>

</body>
</html>
