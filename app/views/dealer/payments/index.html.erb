<div class="min-h-screen bg-gray-50 font-sans" data-controller="verify">

  <main class="p-5 overflow-y-auto">
    <!-- Filters -->
    <!-- Flash Messages -->
<!-- Flash Popup -->
    <div
      data-controller="flash"
      data-flash-duration-value="3000"
      class="fixed top-5 right-5 z-50 space-y-2"
    >
      <% if flash[:notice] %>
        <div
          class="flash-message px-4 py-3 rounded-md bg-green-500 text-white shadow-lg transform transition-all duration-300"
          data-flash-target="message"
        >
          <%= flash[:notice] %>
        </div>
      <% end %>

      <% if flash[:alert] %>
        <div
          class="flash-message px-4 py-3 rounded-md bg-red-500 text-white shadow-lg transform transition-all duration-300"
          data-flash-target="message"
        >
          <%= flash[:alert] %>
        </div>
      <% end %>
    </div>

    <%= form_with url: dealer_payments_index_path, method: :get, local: true, class: "flex flex-wrap gap-3 mb-4" do %>
  <input
    type="text"
    name="transaction_id"
    placeholder="Search by Transaction ID"
    value="<%= params[:transaction_id] %>"
    class="px-3 py-2 border border-gray-300 rounded-md"
  />

  <input
    type="date"
    name="start_date"
    value="<%= params[:start_date] %>"
    class="px-3 py-2 border border-gray-300 rounded-md"
  />

  <input
    type="date"
    name="end_date"
    value="<%= params[:end_date] %>"
    class="px-3 py-2 border border-gray-300 rounded-md"
  />

  <select name="status" class="px-3 py-2 border border-gray-300 rounded-md">
    <option <%= 'selected' if params[:status].blank? || params[:status] == 'All' %>>All</option>
    <option <%= 'selected' if params[:status] == 'pending' %>>Pending</option>
    <option <%= 'selected' if params[:status] == 'success' %>>Success</option>
    <option <%= 'selected' if params[:status] == 'rejected' %>>Rejected</option>
  </select>

  <select name="method" class="px-3 py-2 border border-gray-300 rounded-md">
    <option <%= 'selected' if params[:method].blank? || params[:method] == 'All' %>>All</option>
    <option <%= 'selected' if params[:method] == 'Bank Transfer' %>>Bank Transfer</option>
    <option <%= 'selected' if params[:method] == 'UPI' %>>UPI</option>
    <option <%= 'selected' if params[:method] == 'Credit Card' %>>Credit Card</option>
  </select>

  <!-- Apply Filters Button -->
  <button class="px-4 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700">
    Apply Filters
  </button>
  <a href="<%=dealer_payments_index_path%>" class="px-4 py-2 rounded-md bg-gray-400 text-white hover:bg-gray-700">
    Cencel
  </a>
<% end %>


    <!-- Table -->
    <div class="overflow-x-auto bg-white rounded-lg shadow">
      <table class="min-w-full">
        <thead>
          <tr class="bg-gray-100">
            <th class="px-4 py-3 text-left">Transaction ID</th>
            <th class="px-4 py-3 text-left">Requester</th>
            <th class="px-4 py-3 text-left">Amount</th>
            <th class="px-4 py-3 text-left">Payment Method</th>
            <th class="px-4 py-3 text-left">Date</th>
            <th class="px-4 py-3 text-left">Status</th>
            <th class="px-4 py-3 text-left">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @fund_transactions.each do |fund| %>
            <tr class="border-b border-gray-200 hover:bg-gray-50">
              <td class="px-4 py-3"><%= fund.tx_id %></td>
              <td class="px-4 py-3"><%= fund.wallet.user.first_name %></td>
              <td class="px-4 py-3">₹<%= fund.amount %></td>
              <td class="px-4 py-3"><%= fund.transaction_type %></td>
              <td class="px-4 py-3"><%= fund.created_at.strftime("%d/%m/%Y") %></td>
              <td class="px-4 py-3">
                <span class="font-medium text-yellow-600"><%= fund.status %></span>
              </td>
              <td class="flex px-4 py-3">
               <button
                  class="px-3 py-1 bg-blue-500 text-white rounded mr-2"
                  onclick="openViewModal('<%= fund.tx_id %>', '<%= fund.wallet.user.first_name %>', '<%= fund.amount %>', '<%= fund.transaction_type %>', '<%= fund.created_at.strftime("%d/%m/%Y") %>', '<%= fund.status %>', '<%= fund.fund_request.image if fund.fund_request.image.present? %>')"
                >
                  View
                </button>


                <% if fund.status != "success" && fund.status != "rejected" %>
                  <button data-action="click->verify#open" data-id="<%= fund.id %>"
                    class="px-3 py-1 bg-green-500 text-white rounded mr-2">
                    Approved
                  </button>

                    <button onclick="openRejectModal(<%= fund.id %>)" class="bg-red-600 text-white px-4 py-2 rounded-md">
                  Reject
                </button>

                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </main>

  <!-- Modal -->
  <div
    data-verify-target="container"
    data-action="click->verify#backdrop"
    class="hidden fixed inset-0 flex items-center justify-center z-50"
    style="backdrop-filter: brightness(0.5);"
  >
    <div class="bg-white rounded-2xl shadow-xl w-[688px] p-6 relative mb-12">
      <!-- Close button -->
      <button data-action="click->verify#close"
        class="absolute top-3 right-3 text-gray-500 hover:text-gray-700">
        ✕
      </button>

      <!-- Modal content -->
      <div class="flex justify-between items-center p-4 border-b border-gray-200">
        <h2 class="text-lg sm:text-xl font-semibold text-gray-800">
          Enter Wallet PIN
        </h2>
      </div>

      <!-- PIN Section -->
      <div class="p-6 sm:p-8 flex flex-col items-center">
        <p class="mb-4 font-bold text-black text-center text-xl">
          Enter 6 Digit Wallet PIN
        </p>

        <%= form_with url: dealer_payments_approved_path, method: :post, local: true, class: "space-y-5" do %>
          <!-- Hidden Transaction ID -->
          <input type="hidden" name="id" data-verify-target="transactionId">

          <!-- PIN Inputs -->
          <div class="flex justify-center gap-4 mb-6" id="pin-inputs">
            <% 6.times do |i| %>
              <input 
                type="password" 
                name="pin[]" 
                maxlength="1" 
                data-verify-target="pinInputs"
                data-action="input->verify#pinInput"
                class="w-12 h-12 sm:w-14 sm:h-14 text-center border border-gray-400 rounded-md text-xl font-semibold focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
            <% end %>
          </div>

          <!-- Submit Button -->
          <div class="flex gap-4 justify-center">
            <button
              class="w-28 sm:w-32 py-2 bg-blue-600 text-white rounded-md text-sm sm:text-base font-medium hover:bg-blue-700 transition-colors cursor-pointer">
              Submit
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>


<div
  id="rejectModal"
  class="hidden fixed inset-0 flex items-center justify-center z-50"
  style="backdrop-filter: brightness(0.5);"
>
  <div class="bg-white rounded-2xl shadow-xl w-[688px] p-6 relative mx-4">
    
    <!-- Close Button -->
    <button
      id="closeRejectModal"
      class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 transition"
    >
      ✕
    </button>

    <!-- Header -->
    <div class="text-center mb-6">
      <h2 class="text-2xl font-semibold text-gray-800">Reject Transaction</h2>
      <p class="text-sm text-gray-500 mt-1">
        Please provide a reason for rejection below.
      </p>
    </div>

    <!-- Form -->
    <%= form_with url: dealer_payments_reject_payment_request_path, method: :post, local: true, class: "space-y-6" do %>
      <input type="hidden" id="rejectTransactionId" name="id" />

      <!-- Note Field -->
      <div>
        <label for="note" class="block text-gray-700 font-medium mb-2">
          Note
        </label>
        <textarea
          name="reject_note"
          id="note"
          rows="4"
          placeholder="Enter note here..."
          class="w-full border border-gray-300 rounded-lg px-4 py-2 text-gray-800 focus:ring-2 focus:ring-blue-500 focus:outline-none resize-none"
          required
        ></textarea>
      </div>

      <!-- Action Buttons -->
      <div class="flex justify-end gap-3 pt-4 border-t border-gray-200">
        <button
          type="button"
          id="cancelRejectModal"
          class="px-4 py-2 bg-gray-200 text-gray-800 rounded-md hover:bg-gray-300 transition"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="px-5 py-2 bg-red-600 text-white rounded-md font-medium hover:bg-red-700 transition"
        >
          Reject
        </button>
      </div>
    <% end %>
  </div>
</div>

<!-- View Modal -->
<div
  id="viewModal"
  class="hidden fixed inset-0 flex items-center justify-center z-50"
  style="backdrop-filter: brightness(0.5);"
>
  <div class="bg-white rounded-2xl shadow-xl w-[688px] p-6 relative mx-4">
    <!-- Close Button -->
    <button
      id="closeViewModal"
      class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 transition"
    >
      ✕
    </button>

    <!-- Header -->
    <div class="text-center mb-6">
      <h2 class="text-2xl font-semibold text-gray-800">Transaction Details</h2>
    </div>

    <!-- Details Section -->
    <div id="viewDetails" class="space-y-3 text-gray-700">
      <p><strong>Transaction ID:</strong> <span id="viewTxId"></span></p>
      <p><strong>Requester:</strong> <span id="viewRequester"></span></p>
      <p><strong>Amount:</strong> ₹<span id="viewAmount"></span></p>
      <p><strong>Payment Method:</strong> <span id="viewMethod"></span></p>
      <p><strong>Date:</strong> <span id="viewDate"></span></p>
      <p><strong>Status:</strong> <span id="viewStatus" class="font-semibold"></span></p>

      <!-- Image -->
      <div class="mt-4">
        <p class="font-medium mb-2">Payment Proof:</p>
        <img
          id="viewImage"
          src=""
          alt="Transaction Image"
          class="w-full max-h-96 object-contain rounded-md border border-gray-300 shadow-sm"
        />
      </div>
    </div>
  </div>
</div>



<script>
  // Open reject modal
  function openRejectModal(id) {
    console.log("Reject modal open called with ID:", id);

    document.getElementById("rejectTransactionId").value = id;
    document.getElementById("rejectModal").classList.remove("hidden");
  }

  // Close reject modal
  document.getElementById("closeRejectModal").addEventListener("click", () => {
    document.getElementById("rejectModal").classList.add("hidden");
  });

   document.getElementById("cancelRejectModal").addEventListener("click", () => {
    document.getElementById("rejectModal").classList.add("hidden");
  });

  // Optional: Close when clicking outside modal
  document.getElementById("rejectModal").addEventListener("click", (e) => {
    if (e.target.id === "rejectModal") {
      document.getElementById("rejectModal").classList.add("hidden");
    }
  });
</script>


<script>
  function openViewModal(txId, requester, amount, method, date, status, imageUrl) {
    document.getElementById("viewTxId").textContent = txId || "-";
    document.getElementById("viewRequester").textContent = requester || "-";
    document.getElementById("viewAmount").textContent = amount || "0";
    document.getElementById("viewMethod").textContent = method || "-";
    document.getElementById("viewDate").textContent = date || "-";
    document.getElementById("viewStatus").textContent = status || "-";

    const img = document.getElementById("viewImage");
    if (imageUrl) {
      img.src = imageUrl;
      img.classList.remove("hidden");
    } else {
      img.classList.add("hidden");
    }

    document.getElementById("viewModal").classList.remove("hidden");
  }

  // Close view modal
  document.getElementById("closeViewModal").addEventListener("click", () => {
    document.getElementById("viewModal").classList.add("hidden");
  });

  // Close when clicking outside modal
  document.getElementById("viewModal").addEventListener("click", (e) => {
    if (e.target.id === "viewModal") {
      document.getElementById("viewModal").classList.add("hidden");
    }
  });
</script>
