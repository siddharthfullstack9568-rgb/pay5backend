<main class="flex-1 p-6 bg-blue-50 overflow-y-auto">

<div class="w-[1100px] mx-auto px-6 py-12">
  <!-- Wallet Card -->
  <div class="bg-[#4f6df5] text-white rounded-2xl shadow-lg p-5 flex justify-between items-center">
    <div>
      <h2 class="text-xl font-semibold">My Wallet</h2>
      <p class="text-sm text-white/80 mt-1">Last updated: 2025-07-01 10:30 AM</p>
      <p class="mt-3 text-2xl font-medium"><%=@wallet_balance%></p>
    </div>
    <div class="flex gap-3">
      <a href="<%= dealer_wallets_add_fund_path %>" class="bg-green-500 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-600 transition cursor-pointer">Add Funds</a>
      <a href="#" class="bg-purple-500 text-white px-4 py-2 rounded-lg font-medium hover:bg-purple-600 transition">Withdraw Funds</a>
    </div>
  </div>
  <!-- Search and Filters -->
  <div class="bg-white mt-6 p-4 rounded-xl shadow-sm">
    <div class="flex flex-col md:flex-row justify-between gap-3">
      <input
      type="text"
      placeholder="Search by ID or Description..."
      class="border border-gray-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400"
      />
      <div class="flex items-center gap-2 justify-center md:justify-end mt-2 md:mt-0">
        <button class="bg-blue-600 text-white px-3 py-1.5 rounded-lg text-sm">All</button>
        <button class="bg-gray-100 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-200">Credit</button>
        <button class="bg-gray-100 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-200">Debit</button>
      </div>
    </div>
  </div>
  <!-- Transaction History (Stimulus Controlled Tabs) -->
  <div data-controller="fundtabs" class="bg-white shadow-md rounded-xl w-full mt-6 p-6">
    <!-- Tabs -->
    <div class="flex border-b mb-6">
      <%= link_to dealer_wallets_index_path(mode: 'credit'),
      class: "flex-1 text-center py-3 font-semibold #{params[:mode] == 'credit' ? 'text-indigo-600 border-b-4 border-indigo-600' : 'text-gray-500 hover:bg-gray-50'}" do %>
      Credit History
      <% end %>
      <%= link_to dealer_wallets_index_path(mode: 'debit'),
      class: "flex-1 text-center py-3 font-semibold #{params[:mode] == 'debit' ? 'text-indigo-600 border-b-4 border-indigo-600' : 'text-gray-500 hover:bg-gray-50'}" do %>
      Debit History
      <% end %>
      <%= link_to dealer_wallets_index_path(mode: 'fund'),
      class: "flex-1 text-center py-3 font-semibold #{params[:mode] == 'fund' ? 'text-indigo-600 border-b-4 border-indigo-600' : 'text-gray-500 hover:bg-gray-50'}" do %>
      Fund Request History
      <% end %>
    </div>
    <!-- Credit Table -->
    <%if params[:mode] == "credit" %>
    <div id="credit" data-fundtabs-target="content" class="tab-content">
      <div class="overflow-x-auto">
        <%= render "dealer/wallets/credit", fund_request: @fund_request %>
      </table>
    </div>
  </div>
  <% elsif params[:mode] == "debit" %>
  <div id="debit" data-fundtabs-target="content" class="tab-content">
    <div class="overflow-x-auto">
      <%= render "dealer/wallets/debit_list", fund_request: @fund_request %>
    </table>
  </div>
</div>
<% elsif params[:mode] == "fund" %>
<div id="fund" data-fundtabs-target="content" class="tab-content">
  <div class="overflow-x-auto">
    <%= render "dealer/wallets/fund_list", fund_request: @fund_request %>
  </table>
</div>
</div>
<%end%>

</div>
</div>
</div>
</body>
</html>

<% if flash.any? %>
  <div id="flashModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-40 z-50">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-xl p-6 relative">
      <!-- Close Button -->
      <% flash.each do |key, message| %>
        <div class="mb-4 p-4 rounded-lg 
                    <%= key == 'notice' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
          <%= message %>
        </div>
      <% end %>

      <div class="flex justify-center">
        <button onclick="document.getElementById('flashModal').remove()" 
                class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
          OK
        </button>
      </div>
    </div>
  </div>
</main>
<% end %>