<div class="w-full mx-auto px-6 py-12 bg-blue-50">
  <div class="w-[1000px] mx-auto">
    <!-- Wallet Card -->
    <div class="bg-[#4f6df5] text-white rounded-2xl shadow-lg p-5 flex justify-between items-center">
      <div>
        <h2 class="text-xl font-semibold">My Wallet</h2>
        <p class="text-sm text-white/80 mt-1">Last updated: 2025-07-01 10:30 AM</p>
        <p class="mt-3 text-sm text-red-300 font-medium">Failed to fetch wallet balance</p>
      </div>
      <div class="flex gap-3">
        <a href="<%=dealer_wallets_add_fund_path%>"class="bg-green-500 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-600 transition cursor-pointer">Add Funds</a>
        <a class="bg-purple-500 text-white px-4 py-2 rounded-lg font-medium hover:bg-purple-600 transition">Withdraw Funds</a>
      </div>
    </div>

    <!-- Search and Filters -->
    <div class="bg-white mt-6 p-4 rounded-xl shadow-sm">
      <div class="flex flex-col md:flex-row justify-between gap-3">
        <input 
          type="text" 
          placeholder="Search by ID or Description..." 
          class="border border-gray-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
        <div class="flex items-center gap-2 justify-center md:justify-end mt-2 md:mt-0">
          <button class="bg-blue-600 text-white px-3 py-1.5 rounded-lg text-sm">All</button>
          <button class="bg-gray-100 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-200">Credit</button>
          <button class="bg-gray-100 px-3 py-1.5 rounded-lg text-sm hover:bg-gray-200">Debit</button>
        </div>
      </div>
    </div>

    <!-- Transaction History -->
    <div class="bg-white shadow-md rounded-xl w-full max-w-4xl p-6">
    <h2 class="text-2xl font-semibold text-gray-800 mb-4">
      Transaction History
    </h2>

    <div class="overflow-x-auto">
      <table class="min-w-full border border-gray-200 rounded-lg overflow-hidden">
        <thead class="bg-indigo-600 text-white">
          <tr>
            <th class="py-3 px-4 text-left text-sm font-semibold">#</th>
            <th class="py-3 px-4 text-left text-sm font-semibold">Description</th>
            <th class="py-3 px-4 text-left text-sm font-semibold">Date & Time</th>
            <th class="py-3 px-4 text-right text-sm font-semibold">Amount (₹)</th>
            <th class="py-3 px-4 text-center text-sm font-semibold">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-gray-700">
          <tr class="hover:bg-gray-50 transition">
            <td class="py-3 px-4">1</td>
            <td class="py-3 px-4 font-medium flex items-center gap-2">
              💰 Commission Payout
            </td>
            <td class="py-3 px-4 text-sm text-gray-500">2025-06-30 09:00 AM</td>
            <td class="py-3 px-4 text-right text-green-600 font-semibold">+₹5,000</td>
            <td class="py-3 px-4 text-center">
              <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-1 rounded-full">Success</span>
            </td>
          </tr>

          <tr class="hover:bg-gray-50 transition">
            <td class="py-3 px-4">2</td>
            <td class="py-3 px-4 font-medium flex items-center gap-2">
              🏦 Transfer to Bank
            </td>
            <td class="py-3 px-4 text-sm text-gray-500">2025-06-29 03:15 PM</td>
            <td class="py-3 px-4 text-right text-red-500 font-semibold">-₹1,200</td>
            <td class="py-3 px-4 text-center">
              <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-1 rounded-full">Success</span>
            </td>
          </tr>

          <tr class="hover:bg-gray-50 transition">
            <td class="py-3 px-4">3</td>
            <td class="py-3 px-4 font-medium flex items-center gap-2">
              👥 Referral Bonus
            </td>
            <td class="py-3 px-4 text-sm text-gray-500">2025-06-28 01:10 PM</td>
            <td class="py-3 px-4 text-right text-green-600 font-semibold">+₹2,000</td>
            <td class="py-3 px-4 text-center">
              <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-1 rounded-full">Success</span>
            </td>
          </tr>

          <tr class="hover:bg-gray-50 transition">
            <td class="py-3 px-4">4</td>
            <td class="py-3 px-4 font-medium flex items-center gap-2">
              💡 Bill Payment
            </td>
            <td class="py-3 px-4 text-sm text-gray-500">2025-06-27 11:45 AM</td>
            <td class="py-3 px-4 text-right text-red-500 font-semibold">-₹500</td>
            <td class="py-3 px-4 text-center">
              <span class="bg-red-100 text-red-700 text-xs font-medium px-2 py-1 rounded-full">Failed</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
 
    </div>
  </div>