<!-- Filters -->
<div class="bg-white p-4 rounded shadow flex flex-col md:flex-row items-start md:items-center gap-4">
  <!-- Scheme dropdown -->


<%= form_with url: superadmin_recharge_and_bill_index_path, 
              method: :get, 
              local: true, 
              id: "schemeFilterForm",
              data: { turbo: false } do %>
    <%= select_tag :scheme,
          options_from_collection_for_select(Scheme.all, :id, :scheme_name, params[:scheme]),
          prompt: "Select Scheme",
          required: true,
          class:"border rounded px-3 py-2",
          id: "schemeSelect" %>

    <select name="plan_type" id="planType" class="border rounded px-3 py-2">
      <option value="">-- Select Type --</option>
      <option value="ALL" <%= "selected" if params[:plan_type] == "ALL" %>>All</option>
      <option value="Prepaid" <%= "selected" if params[:plan_type] == "Prepaid" %>>Prepaid</option>
      <option value="Postpaid" <%= "selected" if params[:plan_type] == "Postpaid" %>>Postpaid</option>
    </select>

    <button id="submitFilter"
            class="px-2 py-2 rounded-xl text-white bg-blue-600 cursor-not-allowed opacity-50"
            disabled>
      Submit
    </button>
  <% end %>
</div>

<!-- Flash Messages -->
<% flash.each do |key, message| %>
  <% color = case key.to_sym
    when :notice then "bg-green-500"
    when :alert then "bg-red-500"
    else "bg-blue-500"
  end %>

  <div id="flash-message"
       class="<%= color %> text-white px-4 py-3 rounded shadow-md fixed top-4 right-4 z-50 transition-all duration-500">
    <%= message %>
  </div>
<% end %>

<!-- Commission Table -->
<% if @grouped_commissions.present? %>
  <% @grouped_commissions.each do |category, items| %>
    <div class="bg-white p-6 rounded-lg shadow-md mt-6">
      <h2 class="text-lg font-semibold mb-4"><%= category %></h2>

      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-gray-100 text-left text-sm font-medium text-gray-700">
              <th class="px-4 py-2 border">Service Name</th>
              <th class="px-4 py-2 border">Type</th>
              <th class="px-4 py-2 border">Admin Commission</th>
              <th class="px-4 py-2 border">Master Commission</th>
              <th class="px-4 py-2 border">Dealer Commission</th>
              <th class="px-4 py-2 border">Retailer Commission</th>
              <th class="px-4 py-2 border text-center">Action</th>
            </tr>
          </thead>

          <tbody class="text-sm text-gray-700">
            <% items.each do |item| %>
              <%= form_with url: superadmin_recharge_and_bill_commission_set_path,
                            method: :post,
                            local: true,
                            data: { turbo: false } do %>

                <!-- Hidden scheme_id (auto updated via JS later) -->
                <%= hidden_field_tag :scheme, params[:scheme] %>

                <input type="hidden" name="item_id" value="<%= item.service_product_item.id %>">

                <tr>
                  <td class="px-4 py-2 border"><%= item.service_product_item.name %></td>
                  <td class="px-4 py-2 border"><%= item.service_product_item.service_product.company_name %></td>

                  <td class="px-4 py-2 border">
                    <select name="commission_type" class="border rounded px-2 py-1 w-full text-sm">
                      <option value="commission" <%= "selected" if item.commission_type == "commission" %>>Commission</option>
                      <option value="flat" <%= "selected" if item.commission_type == "flat" %>>Flat</option>
                    </select>
                  </td>

                  <td class="px-4 py-2 border">
                    <%= text_field_tag "commissions[#{item.service_product_item.id}][admin_commission]",
                        Commission.find_by(service_product_item_id: item.service_product_item.id, to_role: "admin")&.value,
                        placeholder: "%", class: "w-full border rounded px-2 py-1 text-sm" %>
                  </td>

                  <td class="px-4 py-2 border">
                    <%= text_field_tag "commissions[#{item.service_product_item.id}][master_commission]",
                        Commission.find_by(service_product_item_id: item.service_product_item.id, to_role: "master")&.value,
                        placeholder: "%", class: "w-full border rounded px-2 py-1 text-sm" %>
                  </td>

                  <td class="px-4 py-2 border">
                    <%= text_field_tag "commissions[#{item.service_product_item.id}][dealer_commission]",
                        Commission.find_by(service_product_item_id: item.service_product_item.id, to_role: "dealer")&.value,
                        placeholder: "%", class: "w-full border rounded px-2 py-1 text-sm" %>
                  </td>

                  <td class="px-4 py-2 border">
                    <%= text_field_tag "commissions[#{item.service_product_item.id}][retailer_commission]",
                        Commission.find_by(service_product_item_id: item.service_product_item.id, to_role: "retailer")&.value,
                        placeholder: "%", class: "w-full border rounded px-2 py-1 text-sm" %>
                  </td>

                  <td class="px-4 py-2 border text-center">
                    <%= submit_tag "Submit",
                        class: "bg-blue-600 text-white px-3 py-2 rounded cursor-pointer" %>
                  </td>
                </tr>

              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% else %>
  <p class="text-gray-500 mt-4">No commissions found for this scheme.</p>
<% end %>



</div>

<!-- ✅ Pure JavaScript logic -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const schemeSelect = document.getElementById("schemeSelect");
    const allForms = document.querySelectorAll("form");
    const submitFilter = document.getElementById("submitFilter");

    function updateSchemeForAllForms() {
      const selectedScheme = schemeSelect.value;
      const hiddenInputs = document.querySelectorAll("input[name='scheme']");

      hiddenInputs.forEach(input => input.value = selectedScheme);

      // Enable/disable buttons based on scheme selection
      const allSubmitButtons = document.querySelectorAll("input[type='submit']");
      allSubmitButtons.forEach(button => {
        if (selectedScheme) {
          button.disabled = false;
          button.classList.remove("opacity-50", "cursor-not-allowed");
        } else {
          button.disabled = true;
          button.classList.add("opacity-50", "cursor-not-allowed");
        }
      });

      // Also toggle filter button
      if (selectedScheme) {
        submitFilter.disabled = false;
        submitFilter.classList.remove("opacity-50", "cursor-not-allowed");
      } else {
        submitFilter.disabled = true;
        submitFilter.classList.add("opacity-50", "cursor-not-allowed");
      }
    }

    schemeSelect.addEventListener("change", updateSchemeForAllForms);

    // Block form submission without a scheme
    allForms.forEach(form => {
      form.addEventListener("submit", function (event) {
        if (!schemeSelect.value) {
          event.preventDefault();
          alert("⚠️ Please select a scheme before submitting the form.");
        }
      });
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const schemeSelect = document.getElementById("schemeSelect");
    const submitButton = document.getElementById("submitFilter");

    schemeSelect.addEventListener("change", () => {
      if (schemeSelect.value) {
        submitButton.disabled = false;
        submitButton.classList.remove("cursor-not-allowed", "opacity-50");
      } else {
        submitButton.disabled = true;
        submitButton.classList.add("cursor-not-allowed", "opacity-50");
      }
    });
  });
</script>
