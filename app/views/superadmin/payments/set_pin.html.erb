<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Transaction PIN</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gray-50">

  <div class="bg-white rounded-2xl shadow-lg w-full max-w-md p-8 m-auto">
    <h2 class="text-3xl font-semibold text-center text-gray-800 mb-6">
      🔒 Reset Transaction PIN
    </h2>

    <!-- Flash Messages -->
    <% flash.each do |key, message| %>
      <% color = case key.to_sym
        when :notice then "bg-green-100 text-green-700 border-green-400"
        when :alert  then "bg-red-100 text-red-700 border-red-400"
        else "bg-yellow-100 text-yellow-700 border-yellow-400"
      end %>

      <div class="border-l-4 p-3 mb-4 rounded #{color}">
        <p class="text-sm font-medium"><%= message %></p>
      </div>
    <% end %>

    <%= form_with url: superadmin_payments_set_pin_update_path, method: :post, local: true, id: "resetPinForm", class: "space-y-5" do %>
      <p class="text-sm text-gray-600 text-center mb-4">
        Enter your old and new 6-digit wallet PIN.
      </p>

      <!-- Old PIN -->
      <div>
        <label class="text-sm font-medium text-gray-700">
          Old PIN <span class="text-red-600">*</span>
        </label>
        <div class="relative">
          <%= password_field_tag :old_pin, nil,
            id: "old_pin",
            maxlength: 6,
            placeholder: "Enter Old PIN",
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-center tracking-widest pr-10",
            required: true %>
          <button type="button" id="toggleOldPin" class="absolute right-3 top-2.5 text-gray-500 hover:text-gray-700">
            👁️
          </button>
        </div>
      </div>

      <!-- New PIN -->
      <div>
        <label class="text-sm font-medium text-gray-700">
          New PIN <span class="text-red-600">*</span>
        </label>
        <div class="relative">
          <%= password_field_tag :set_pin, nil,
            id: "new_pin",
            maxlength: 6,
            placeholder: "Enter New PIN",
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-center tracking-widest pr-10",
            required: true %>
          <button type="button" id="toggleNewPin" class="absolute right-3 top-2.5 text-gray-500 hover:text-gray-700">
            👁️
          </button>
        </div>
      </div>

      <!-- Confirm PIN -->
      <div>
        <label class="text-sm font-medium text-gray-700">
          Confirm New PIN <span class="text-red-600">*</span>
        </label>
        <div class="relative">
          <%= password_field_tag :confirm_pin, nil,
            id: "confirm_pin",
            maxlength: 6,
            placeholder: "Confirm New PIN",
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-center tracking-widest pr-10",
            required: true %>
          <button type="button" id="toggleConfirmPin" class="absolute right-3 top-2.5 text-gray-500 hover:text-gray-700">
            👁️
          </button>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex gap-3">
        <%= submit_tag "Reset PIN",
          id: "submitBtn",
          class: "w-1/2 bg-indigo-600 text-white py-2 rounded-lg hover:bg-indigo-700 transition font-medium" %>

        <button type="button"
          onclick="history.back()"
          class="w-1/2 bg-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-400 transition font-medium">
          Back
        </button>
      </div>
    <% end %>

    <p class="text-center text-sm text-gray-500 mt-2">
      Forgot old PIN?
      <%#= link_to "Click here", forgetpin_path, class: "text-blue-600 hover:underline" %>
    </p>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // Allow only numeric input
      document.querySelectorAll("#old_pin, #new_pin, #confirm_pin").forEach((input) => {
        input.addEventListener("input", (e) => {
          e.target.value = e.target.value.replace(/\D/g, "");
        });
      });

      // Eye toggle logic
      const toggleVisibility = (buttonId, inputId) => {
        const button = document.getElementById(buttonId);
        const input = document.getElementById(inputId);

        button.addEventListener("click", () => {
          if (input.type === "password") {
            input.type = "text";
            button.textContent = "🙈";
          } else {
            input.type = "password";
            button.textContent = "👁️";
          }
        });
      };

      toggleVisibility("toggleOldPin", "old_pin");
      toggleVisibility("toggleNewPin", "new_pin");
      toggleVisibility("toggleConfirmPin", "confirm_pin");
    });
  </script>
</body>
</html>
