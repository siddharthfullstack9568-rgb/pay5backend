<!-- Forgot Password -->
  <script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-gray-50 flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div class="text-center">
      <h2 class="mt-6 text-3xl font-extrabold text-gray-900">Forgot your password?</h2>
      <p class="mt-2 text-sm text-gray-600">
        Enter your email address and we'll send you a link to reset your password.
      </p>
    </div>

    <% if flash[:notice] %>
      <div class="rounded-md bg-green-50 p-4">
        <div class="flex">
          <div class="ml-3">
            <p class="text-sm text-green-700"><%= flash[:notice] %></p>
          </div>
        </div>
      </div>
    <% end %>

    <% if flash[:alert] %>
      <div class="rounded-md bg-red-50 p-4">
        <div class="flex">
          <div class="ml-3">
            <p class="text-sm text-red-700"><%= flash[:alert] %></p>
          </div>
        </div>
      </div>
    <% end %>

    <div class="bg-white py-8 px-6 shadow rounded-lg">
      <%= form_with url: forgot_email_sessions_path, method: :post, local: true do |f| %>
        <div class="space-y-6">
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700">Email address</label>
            <div class="mt-1 relative rounded-md shadow-sm">
              <input
                id="email"
                name="email"
                type="email"
                required
                placeholder="you@example.com"
                value="<%= params[:email] %>"
                class="appearance-none block w-full px-3 py-3 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
              />
            </div>
          </div>

          <div>
            <button
              type="submit"
              class="w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              Send OTP
            </button>
          </div>

          <div class="text-sm text-center">
            <%= link_to "Back to login", master_sessions_login_path(:user), class: "font-medium text-indigo-600 hover:text-indigo-500" %>
          </div>
        </div>
      <% end %>
    </div>

    <p class="mt-6 text-center text-xs text-gray-400">
      If you don't receive an email, check your spam folder or try again.
    </p>
  </div>
</div>
