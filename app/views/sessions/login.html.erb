<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-black">
  <div class="bg-white w-[900px] max-w-[95vw] rounded-xl shadow-2xl overflow-hidden flex">

    <!-- LEFT : LOGIN FORM -->
    <div class="w-full md:w-1/2 p-10">
      <h2 class="text-2xl font-semibold mb-2">Welcome</h2>
      <p class="text-gray-500 mb-6">Please Login To Admin Dashboard</p>

      <!-- Tabs -->
      <div class="flex gap-3 mb-6">
        <button class="px-4 py-2 bg-gray-200 text-sm rounded-md font-medium">
          Login with Password
        </button>
        <button class="px-4 py-2 border text-sm rounded-md text-gray-600">
          Mobile with OTP
        </button>
      </div>

      <%= form_with url: create_sessions_path, method: :post do |f| %>

        <!-- Flash Messages -->
        <% if flash[:alert] %>
          <div class="mb-4 text-sm bg-red-100 border border-red-400 text-red-700 px-4 py-2 rounded">
            <%= flash[:alert] %>
          </div>
        <% elsif flash[:notice] %>
          <div class="mb-4 text-sm bg-green-100 border border-green-400 text-green-700 px-4 py-2 rounded">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <!-- User ID -->
        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-1">User ID</label>
          <input
            name="email"
            type="text"
            placeholder="retailer@company.com"
            class="w-full px-4 py-3 bg-gray-100 border rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
        </div>

        <!-- Password -->
        <div class="mb-2">
          <label class="block text-sm font-medium text-gray-700 mb-1">Password</label>
          <input
            name="password"
            type="password"
            placeholder="••••••••"
            class="w-full px-4 py-3 bg-gray-100 border rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
        </div>

        <!-- Forgot Password -->
        <div class="text-right mb-4">
          <a href="/superadmin/sessions/forgot_page" class="text-sm text-green-600 hover:underline">
            Forgot Password?
          </a>
        </div>

        <!-- Submit -->
        <button
          type="submit"
          class="w-full bg-black text-white py-3 rounded-md font-semibold hover:bg-gray-800 transition"
        >
          Submit
        </button>

      <% end %>

      <!-- Signup -->
      <p class="text-sm text-center text-gray-500 mt-6">
        Don’t have an account?
        <a href="#" class="text-blue-600 font-medium hover:underline">Signup</a>
      </p>
    </div>

    <!-- RIGHT : ILLUSTRATION -->
    <div class="hidden md:flex w-1/2 bg-gray-50 items-center justify-center p-6">
      <img
        src="https://cdn.dribbble.com/users/1769954/screenshots/14544853/media/91b5fda0b7b6c8c6d9cc75d8d17e1a8b.png"
        alt="Fintech Illustration"
        class="max-w-full h-auto"
      />
    </div>

  </div>
</body>
</html>
